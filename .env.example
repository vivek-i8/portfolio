# Chat assistant providers: OpenRouter is primary, Groq is fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: raises the GitHub API rate limit used by the /github dashboard.
GITHUB_TOKEN=

# Contact form delivery. Use a Gmail app password, not the account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=